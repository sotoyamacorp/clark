---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { siteConfig } from '../lib/site-config';
import { canonicalUrl } from '../lib/seo';
import { organizationSchema, articleSchema } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  // 記事(.mdx)のフロントマターから layout 経由で渡ってくる場合のみ指定される
  publishedAt?: Date;
  author?: string;
}

// MDX/Markdownの `layout:` フロントマター経由の場合、フィールドは
// Astro.props.frontmatter にネストされて渡ってくる（.astro側から
// <BaseLayout title="..."> のように直接propsで渡す場合はフラットなまま）。
// 両方のケースに対応する。
const props = (Astro.props as { frontmatter?: Props }).frontmatter ?? Astro.props;
const { title, description = siteConfig.description, ogImage, publishedAt, author } = props;

const pageTitle = `${title} | ${siteConfig.name}`;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const orgJsonLd = organizationSchema();
const articleJsonLd = publishedAt
  ? articleSchema({
      headline: title,
      description,
      datePublished: new Date(publishedAt).toISOString(),
      authorId: author,
      url: canonical,
      image: ogImage,
    })
  : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Noto Sans JP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} />
    {articleJsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
    )}

    <!-- Google Analytics (GA4) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId: siteConfig.gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaMeasurementId);
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
