---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { siteConfig, siteText } from '../lib/site-config';
import { canonicalUrl } from '../lib/seo';
import { organizationSchema, articleSchema } from '../lib/schema';
import { getLangFromUrl, getAlternatePath } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  // 記事(.mdx)のフロントマターから layout 経由で渡ってくる場合のみ指定される
  publishedAt?: Date;
  author?: string;
  // レビューゲート運用の下書き記事に付与するフラグ。true の間は下書きバナーを表示し、
  // 検索エンジンのインデックス対象からも除外する。承認後の本番公開時にこのフィールドごと
  // frontmatterから外すこと(clark-site/CLAUDE.md参照)。
  draft?: boolean;
}

// MDX/Markdownの `layout:` フロントマター経由の場合、フィールドは
// Astro.props.frontmatter にネストされて渡ってくる（.astro側から
// <BaseLayout title="..."> のように直接propsで渡す場合はフラットなまま）。
// 両方のケースに対応する。
const props = (Astro.props as { frontmatter?: Props }).frontmatter ?? Astro.props;
const locale = getLangFromUrl(Astro.url);
const { title, description = siteText[locale].description, ogImage = '/og/og-default.png', publishedAt, author, draft = false } = props;

const pageTitle = `${title} | ${siteText[locale].name}`;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const alternatePath = getAlternatePath(Astro.url.pathname, locale);
const alternateUrl = canonicalUrl(alternatePath, Astro.site);
const jaUrl = locale === 'ja' ? canonical : alternateUrl;
const enUrl = locale === 'en' ? canonical : alternateUrl;
const ogImageUrl = canonicalUrl(ogImage, Astro.site);
const orgJsonLd = organizationSchema(locale);
const articleJsonLd = publishedAt
  ? articleSchema({
      headline: title,
      description,
      datePublished: new Date(publishedAt).toISOString(),
      authorId: author,
      url: canonical,
      image: ogImageUrl,
      locale,
    })
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={jaUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteText[locale].name}
      href={locale === 'ja' ? '/rss.xml' : '/en/rss.xml'}
    />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteText[locale].name} />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Noto Sans JP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} />
    {articleJsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
    )}

    <!-- Google Analytics (GA4)。下書きプレビューでは計測しない -->
    {!draft && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId: siteConfig.gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    {draft && (
      <div class="sticky top-0 z-50 bg-amber-400 text-amber-950 px-4 py-3 text-center text-sm font-bold shadow-md">
        {locale === 'ja'
          ? '🚧 下書きプレビュー：この記事はまだ公開されていません。承認後、後日サイトに公開されます。'
          : '🚧 Draft preview: this article is not published yet. It will go live after approval.'}
      </div>
    )}
    <Header locale={locale} alternatePath={alternatePath} />
    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Footer locale={locale} />
    <ChatWidget locale={locale} />
  </body>
</html>
