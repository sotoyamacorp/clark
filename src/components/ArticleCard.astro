---
import type { Article } from '../lib/articles';

interface Props {
  post: Article;
}

const { post } = Astro.props;
---

<article class="flex h-full flex-col rounded-xl border border-navy-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md hover:border-navy-200">
  <div class="mb-3 flex items-center justify-between gap-3">
    <span class="inline-block rounded bg-accent-100 px-3 py-1 text-sm font-semibold text-accent-700">
      {post.category}
    </span>
    <time class="shrink-0 whitespace-nowrap text-sm text-navy-600">
      {post.publishedAt.toLocaleDateString('ja-JP')}
    </time>
  </div>

  <h3 class="mb-2 text-lg font-bold leading-snug text-navy-950">
    <a href={`/articles/${post.slug}`} class="hover:text-accent-700 transition-colors">
      {post.title}
    </a>
  </h3>

  <p class="mb-4 flex-1 text-base leading-relaxed text-navy-700">{post.description}</p>

  <div class="mb-4 flex flex-wrap gap-2">
    {post.tags.map((tag) => (
      <span class="inline-block rounded bg-navy-50 px-3 py-1 text-sm text-navy-700">
        {tag}
      </span>
    ))}
  </div>

  <a href={`/articles/${post.slug}`} class="mt-auto font-semibold text-accent-700 hover:underline">
    記事を読む →
  </a>
</article>
