---
import type { Article } from '../lib/articles';
import { regionLabels, regionBadgeStyles, categoryLabels } from '../lib/articles';
import { localizedPath, useTranslations, type Locale } from '../lib/i18n';

interface Props {
  post: Article;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const content = post.translations[locale];
const href = localizedPath(`/articles/${post.slug}`, locale);
const dateLocale = locale === 'ja' ? 'ja-JP' : 'en-US';
// 「本日公開」バッジの判定はビルド時ではなくクライアント側(下記script)で行う。
// ビルド時判定だと、公開日の翌日以降にリビルドが走らなかった場合、古い記事に
// バッジが残り続けてしまう(静的HTMLに焼き付いてしまうため)。訪問者のブラウザで
// 実際の「今日」と比較することで、リビルド頻度に依存せず正しい表示を保つ。
const publishedDateStr = `${post.publishedAt.getFullYear()}-${String(post.publishedAt.getMonth() + 1).padStart(2, '0')}-${String(post.publishedAt.getDate()).padStart(2, '0')}`;
const isDraft = post.draft === true;
---

<article
  data-region={post.region}
  data-published-date={publishedDateStr}
  data-draft={isDraft ? 'true' : undefined}
  class={`relative flex h-full flex-col rounded-xl border bg-white p-6 shadow-sm transition-shadow hover:shadow-md ${
    isDraft ? 'border-amber-400 ring-2 ring-amber-100' : 'border-navy-100 hover:border-navy-200'
  }`}
>
  {isDraft ? (
    <span class="absolute -top-3 -right-3 inline-flex items-center gap-1 rounded-full bg-amber-400 px-3 py-1 text-xs font-bold text-amber-950 shadow-md">
      {t.articleCard.underReview}
    </span>
  ) : (
    <span
      data-today-badge
      class="hidden absolute -top-3 -right-3 items-center gap-1 rounded-full bg-red-500 px-3 py-1 text-xs font-bold text-white shadow-md"
    >
      {t.articleCard.publishedToday}
    </span>
  )}
  <div class="mb-3 flex items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class={`inline-block rounded-full px-3 py-1 text-sm font-semibold ${regionBadgeStyles[post.region]}`}>
        {regionLabels[locale][post.region]}
      </span>
      <span class="inline-block rounded bg-accent-100 px-3 py-1 text-sm font-semibold text-accent-700">
        {categoryLabels[locale][post.category] ?? post.category}
      </span>
    </div>
    <time class="shrink-0 whitespace-nowrap text-sm text-navy-600">
      {post.publishedAt.toLocaleDateString(dateLocale)}
    </time>
  </div>

  <h3 class="mb-2 text-lg font-bold leading-snug text-navy-950">
    <a href={href} class="hover:text-accent-700 transition-colors">
      {content.title}
    </a>
  </h3>

  <p class="mb-4 flex-1 text-base leading-relaxed text-navy-700">{content.description}</p>

  <div class="mb-4 flex flex-wrap gap-2">
    {content.tags.map((tag) => (
      <span class="inline-block rounded bg-navy-50 px-3 py-1 text-sm text-navy-700">
        {tag}
      </span>
    ))}
  </div>

  <a href={href} class="mt-auto font-semibold text-accent-700 hover:underline">
    {t.articleCard.readMore}
  </a>
</article>

<script>
  // 複数のArticleCardインスタンスがあってもAstroが重複スクリプトを1つに束ねるため、
  // ページ内で一度だけ実行される。
  function highlightTodayArticles() {
    const now = new Date();
    const todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

    document.querySelectorAll<HTMLElement>('[data-published-date]:not([data-draft])').forEach((el) => {
      if (el.getAttribute('data-published-date') !== todayStr) return;
      el.classList.remove('border-navy-100');
      el.classList.add('border-red-400', 'ring-2', 'ring-red-100');
      const badge = el.querySelector<HTMLElement>('[data-today-badge]');
      if (badge) {
        badge.classList.remove('hidden');
        badge.classList.add('inline-flex');
      }
    });
  }

  highlightTodayArticles();
</script>
