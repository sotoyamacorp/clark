---
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).chat;
---

<div class="fixed bottom-5 right-5 z-50">
  <button
    id="chat-launcher"
    type="button"
    aria-label={t.launcherLabel}
    aria-expanded="false"
    class="flex h-14 w-14 items-center justify-center rounded-full bg-navy-950 text-accent-500 shadow-lg transition-transform hover:scale-105"
  >
    <svg id="chat-launcher-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
    </svg>
    <svg id="chat-launcher-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-6 w-6">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>

  <div
    id="chat-panel"
    class="chat-panel hidden fixed bottom-24 right-5 flex max-h-[70vh] w-[min(92vw,360px)] flex-col overflow-hidden rounded-xl border border-navy-100 bg-white shadow-2xl"
    role="dialog"
    aria-label={t.heading}
  >
    <div class="flex items-center justify-between bg-navy-950 px-5 py-4">
      <div>
        <p class="text-sm font-bold text-white">{t.heading}</p>
        <p class="text-xs text-navy-200">{t.subheading}</p>
      </div>
      <button id="chat-close" type="button" aria-label={t.close} class="text-navy-300 hover:text-white">
        ✕
      </button>
    </div>

    <div id="chat-gate" class="flex flex-col gap-3 p-5">
      <p class="text-sm leading-relaxed text-navy-700">{t.gateDescription}</p>
      <form id="chat-gate-form" class="flex flex-col gap-2">
        <label class="sr-only" for="chat-email">{t.emailPlaceholder}</label>
        <input
          id="chat-email"
          type="email"
          required
          placeholder={t.emailPlaceholder}
          class="w-full rounded-full border border-navy-200 px-4 py-2 text-sm text-navy-950 focus:border-navy-950 focus:outline-none"
        />
        <button
          type="submit"
          class="rounded-full bg-navy-950 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-navy-800"
        >
          {t.startButton}
        </button>
      </form>
      <p id="chat-gate-error" class="hidden text-xs text-red-600">{t.invalidEmail}</p>
    </div>

    <div id="chat-body" class="hidden flex-1 flex-col overflow-hidden">
      <div id="chat-messages" class="chat-messages flex-1 space-y-3 overflow-y-auto p-4"></div>
      <form id="chat-form" class="flex items-center gap-2 border-t border-navy-100 p-3">
        <label class="sr-only" for="chat-input">{t.inputPlaceholder}</label>
        <input
          id="chat-input"
          type="text"
          placeholder={t.inputPlaceholder}
          autocomplete="off"
          class="w-full rounded-full border border-navy-200 px-4 py-2 text-sm text-navy-950 focus:border-navy-950 focus:outline-none"
        />
        <button
          type="submit"
          class="shrink-0 rounded-full bg-navy-950 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-navy-800"
        >
          {t.send}
        </button>
      </form>
      <p class="px-4 pb-3 text-[11px] leading-snug text-navy-400">{t.disclaimer}</p>
    </div>
  </div>
</div>

<script define:vars={{ locale, strings: t }}>
  const launcher = document.getElementById('chat-launcher');
  const launcherIconOpen = document.getElementById('chat-launcher-icon-open');
  const launcherIconClose = document.getElementById('chat-launcher-icon-close');
  const panel = document.getElementById('chat-panel');
  const closeBtn = document.getElementById('chat-close');
  const gate = document.getElementById('chat-gate');
  const gateForm = document.getElementById('chat-gate-form');
  const gateError = document.getElementById('chat-gate-error');
  const emailInput = document.getElementById('chat-email');
  const body = document.getElementById('chat-body');
  const messagesEl = document.getElementById('chat-messages');
  const chatForm = document.getElementById('chat-form');
  const chatInput = document.getElementById('chat-input');

  const STORAGE_KEY = 'chatEmailVerified';
  let history = [];

  function isVerified() {
    try {
      return !!localStorage.getItem(STORAGE_KEY);
    } catch {
      return false;
    }
  }

  function showChatBody() {
    gate.classList.add('hidden');
    body.classList.remove('hidden');
    body.classList.add('flex');
    chatInput.focus();
  }

  function setPanelOpen(open) {
    panel.classList.toggle('hidden', !open);
    launcher.setAttribute('aria-expanded', String(open));
    launcherIconOpen.classList.toggle('hidden', open);
    launcherIconClose.classList.toggle('hidden', !open);
    if (open && isVerified()) showChatBody();
  }

  launcher.addEventListener('click', () => {
    setPanelOpen(panel.classList.contains('hidden'));
  });
  closeBtn.addEventListener('click', () => setPanelOpen(false));

  gateForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      gateError.classList.remove('hidden');
      return;
    }
    gateError.classList.add('hidden');
    const submitBtn = gateForm.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    try {
      await fetch('/api/chat-lead', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email }),
      });
    } catch {
      // ネットワークエラーでもチャット自体は使えるようにする(リード登録は失敗しても致命的ではない)
    }
    try {
      localStorage.setItem(STORAGE_KEY, email);
    } catch {
      // localStorageが使えない環境でもチャットは継続させる
    }
    submitBtn.disabled = false;
    showChatBody();
  });

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // AIの回答はMarkdown風の記法(**強調**・箇条書き・番号リスト)を含むことがあるため、
  // 生のアスタリスクや記号がそのまま表示されないよう最低限のHTML変換をする。
  // ユーザー自身の入力はtextContentのままにし、この変換は適用しない。
  function formatBotMessage(raw) {
    const escaped = escapeHtml(raw).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

    const blocks = escaped.split(/\n\s*\n/);
    return blocks
      .map((block) => {
        const lines = block
          .split('\n')
          .map((line) => line.trim())
          .filter(Boolean);
        if (lines.length === 0) return '';

        if (lines.every((line) => /^[-*]\s+/.test(line))) {
          return `<ul>${lines.map((line) => `<li>${line.replace(/^[-*]\s+/, '')}</li>`).join('')}</ul>`;
        }
        if (lines.every((line) => /^\d+[.)]\s+/.test(line))) {
          return `<ol>${lines.map((line) => `<li>${line.replace(/^\d+[.)]\s+/, '')}</li>`).join('')}</ol>`;
        }
        return `<p>${lines.join('<br>')}</p>`;
      })
      .join('');
  }

  function appendMessage(role, text) {
    const wrapper = document.createElement('div');
    wrapper.className = `chat-msg chat-msg-${role}`;
    if (role === 'bot') {
      wrapper.innerHTML = formatBotMessage(text);
    } else {
      wrapper.textContent = text;
    }
    messagesEl.appendChild(wrapper);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return wrapper;
  }

  function appendSources(sources) {
    if (!sources || !sources.length) return;
    const wrap = document.createElement('div');
    wrap.className = 'chat-sources';
    const label = document.createElement('p');
    label.className = 'chat-sources-label';
    label.textContent = `${strings.sourcesLabel}:`;
    wrap.appendChild(label);
    sources.forEach((s) => {
      const a = document.createElement('a');
      a.href = s.url;
      a.textContent = s.title;
      wrap.appendChild(a);
    });
    messagesEl.appendChild(wrap);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const message = chatInput.value.trim();
    if (!message) return;
    chatInput.value = '';
    appendMessage('user', message);
    history.push({ role: 'user', content: message });

    const thinkingEl = appendMessage('bot', strings.thinking);
    const submitBtn = chatForm.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    chatInput.disabled = true;

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ message, history: history.slice(-6), locale }),
      });
      const data = await res.json();
      thinkingEl.remove();
      if (!res.ok || data.error) {
        appendMessage('bot', strings.errorMessage);
      } else {
        appendMessage('bot', data.reply);
        history.push({ role: 'assistant', content: data.reply });
        appendSources(data.sources);
      }
    } catch {
      thinkingEl.remove();
      appendMessage('bot', strings.errorMessage);
    } finally {
      submitBtn.disabled = false;
      chatInput.disabled = false;
      chatInput.focus();
    }
  });
</script>

<style is:global>
  /*
   * チャットメッセージはクライアントJSがdocument.createElementで生成するため、
   * Astroの通常のscoped styleでは対象要素にdata-astro-cid属性が付かず一切当たらない。
   * このstyleブロックを意図的にis:globalにして、動的に生成される要素にも効くようにしている。
   */
  .chat-msg {
    max-width: 85%;
    border-radius: 0.9rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.875rem;
    line-height: 1.6;
    word-break: break-word;
  }
  .chat-msg-user {
    margin-left: auto;
    background: var(--color-navy-950, #0b1826);
    color: #fff;
    white-space: pre-wrap;
  }
  .chat-msg-bot {
    margin-right: auto;
    background: var(--color-navy-50, #f6f8fb);
    color: var(--color-navy-800, #1a3450);
    border: 1px solid var(--color-navy-100, #e6ecf3);
  }
  .chat-msg-bot p {
    margin: 0;
  }
  .chat-msg-bot p + p {
    margin-top: 0.6rem;
  }
  .chat-msg-bot ul,
  .chat-msg-bot ol {
    margin: 0.4rem 0 0;
    padding-left: 1.25rem;
  }
  .chat-msg-bot ul {
    list-style-type: disc;
  }
  .chat-msg-bot ol {
    list-style-type: decimal;
  }
  .chat-msg-bot li + li {
    margin-top: 0.25rem;
  }
  .chat-msg-bot strong {
    color: var(--color-navy-950, #0b1826);
    font-weight: 700;
  }
  .chat-sources {
    margin-right: auto;
    display: flex;
    max-width: 85%;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.75rem;
    padding: 0 0.1rem;
  }
  .chat-sources-label {
    font-weight: 600;
    color: var(--color-navy-600, #3d5c82);
  }
  .chat-sources a {
    color: var(--color-accent-700, #8a651f);
    text-decoration: underline;
  }
  .chat-sources a:hover {
    color: var(--color-accent-500, #c2954a);
  }
</style>
