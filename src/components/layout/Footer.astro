---
import { siteConfig, siteText } from '../../lib/site-config';
import { useTranslations, localizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-navy-950 text-navy-200">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <p class="mb-3 text-lg font-bold text-white">{siteText[locale].name}</p>
        <p class="text-base leading-relaxed">{siteText[locale].description}</p>
      </div>
      <div>
        <p class="eyebrow mb-3 text-xs font-semibold uppercase text-accent-500">{t.footer.navigation}</p>
        <ul class="space-y-2 text-base">
          <li><a href={localizedPath('/articles', locale)} class="hover:text-white">{t.nav.articles}</a></li>
          <li><a href={localizedPath('/glossary', locale)} class="hover:text-white">{t.nav.glossary}</a></li>
          <li><a href={localizedPath('/about', locale)} class="hover:text-white">{t.nav.about}</a></li>
          <li><a href={localizedPath('/contact', locale)} class="hover:text-white">{t.nav.contact}</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-3 text-xs font-semibold uppercase text-accent-500">{t.footer.contact}</p>
        <a href={`mailto:${siteConfig.contactEmail}`} class="text-base hover:text-white">
          {siteConfig.contactEmail}
        </a>
      </div>
    </div>
    <div class="mt-12 border-t border-navy-800 pt-6 text-sm text-navy-200">
      &copy; {year} {siteText[locale].name}
    </div>
  </div>
</footer>
