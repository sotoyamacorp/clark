---
import { siteText } from '../../lib/site-config';
import { useTranslations, localizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { href: localizedPath('/articles', locale), label: t.nav.articles },
  { href: localizedPath('/glossary', locale), label: t.nav.glossary },
  { href: localizedPath('/about', locale), label: t.nav.about },
];
---

<header class="relative border-b border-navy-100 bg-white">
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)_auto] items-center gap-2 px-3 py-4 sm:gap-3 sm:px-6 sm:py-5">
    <a href={localizedPath('/', locale)} class="flex min-w-0 items-center gap-2 overflow-hidden sm:gap-2.5">
      <span
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-navy-950 text-xs font-bold text-accent-500 sm:h-9 sm:w-9 sm:text-sm"
        aria-hidden="true"
      >
        PH
      </span>
      <span class="min-w-0 flex-1 truncate text-base font-bold tracking-tight text-navy-950 sm:text-lg">
        {siteText[locale].name}
      </span>
    </a>
    <nav aria-label={locale === 'ja' ? 'メインナビゲーション' : 'Main navigation'} class="flex shrink-0 items-center gap-2 sm:gap-6">
      <ul class="hidden gap-6 text-base sm:flex">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="text-navy-700 hover:text-navy-950">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <button
        id="mobile-menu-button"
        type="button"
        class="flex shrink-0 items-center text-navy-700 hover:text-navy-950 sm:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={locale === 'ja' ? 'メニューを開く' : 'Open menu'}
      >
        <svg id="mobile-menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="mobile-menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
      <a
        href={localizedPath('/search', locale)}
        class="flex shrink-0 items-center text-navy-700 hover:text-navy-950"
        aria-label={t.nav.search}
        title={t.nav.search}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </a>
      <a
        href={alternatePath}
        class="whitespace-nowrap text-sm font-semibold text-navy-700 hover:text-navy-950"
        rel="alternate"
      >
        {t.language.switchTo}
      </a>
      <a
        href={localizedPath('/contact', locale)}
        class="flex shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-navy-950 text-sm font-semibold text-white transition-colors hover:bg-navy-800 h-8 w-8 sm:h-auto sm:w-auto sm:px-5 sm:py-2.5"
        aria-label={t.nav.contact}
        title={t.nav.contact}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sm:hidden">
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <span class="hidden sm:inline">{t.nav.contact}</span>
      </a>
    </nav>
  </div>
  <div
    id="mobile-menu"
    class="hidden absolute inset-x-0 top-full z-40 border-t border-navy-100 bg-white shadow-md sm:hidden"
  >
    <ul class="flex flex-col px-3 py-2">
      {navItems.map((item) => (
        <li class="border-b border-navy-50 last:border-b-0">
          <a href={item.href} class="block px-1 py-3 text-base text-navy-700 hover:text-navy-950">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  function setMenuOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  button?.addEventListener('click', () => {
    setMenuOpen(menu?.classList.contains('hidden') ?? false);
  });

  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenuOpen(false);
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (!menu || menu.classList.contains('hidden')) return;
    if (target.closest('#mobile-menu, #mobile-menu-button')) return;
    setMenuOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });
</script>
