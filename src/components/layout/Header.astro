---
import { siteConfig } from '../../lib/site-config';

const navItems = [
  { href: '/about', label: '私たちについて' },
  { href: '/contact', label: 'お問い合わせ' },
];
---

<header class="border-b border-navy-100 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="text-lg font-bold text-navy-900 sm:text-xl">
      {siteConfig.name}
    </a>
    <nav aria-label="メインナビゲーション">
      <ul class="flex gap-4 text-base sm:gap-6">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-navy-800 underline-offset-4 hover:text-accent-600 hover:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
