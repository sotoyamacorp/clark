---
import { siteText } from '../../lib/site-config';
import { useTranslations, localizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { href: localizedPath('/articles', locale), label: t.nav.articles },
  { href: localizedPath('/glossary', locale), label: t.nav.glossary },
  { href: localizedPath('/about', locale), label: t.nav.about },
];
---

<header class="border-b border-navy-100 bg-white">
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)_auto] items-center gap-2 px-3 py-4 sm:gap-3 sm:px-6 sm:py-5">
    <a href={localizedPath('/', locale)} class="flex min-w-0 items-center gap-2 overflow-hidden sm:gap-2.5">
      <span
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-navy-950 text-xs font-bold text-accent-500 sm:h-9 sm:w-9 sm:text-sm"
        aria-hidden="true"
      >
        PH
      </span>
      <span class="min-w-0 flex-1 truncate text-base font-bold tracking-tight text-navy-950 sm:text-lg">
        {siteText[locale].name}
      </span>
    </a>
    <nav aria-label={locale === 'ja' ? 'メインナビゲーション' : 'Main navigation'} class="flex shrink-0 items-center gap-2 sm:gap-6">
      <ul class="hidden gap-6 text-base sm:flex">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="text-navy-700 hover:text-navy-950">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={localizedPath('/search', locale)}
        class="flex shrink-0 items-center text-navy-700 hover:text-navy-950"
        aria-label={t.nav.search}
        title={t.nav.search}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </a>
      <a
        href={alternatePath}
        class="whitespace-nowrap text-sm font-semibold text-navy-700 hover:text-navy-950"
        rel="alternate"
      >
        {t.language.switchTo}
      </a>
      <a
        href={localizedPath('/contact', locale)}
        class="flex shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-navy-950 text-sm font-semibold text-white transition-colors hover:bg-navy-800 h-8 w-8 sm:h-auto sm:w-auto sm:px-5 sm:py-2.5"
        aria-label={t.nav.contact}
        title={t.nav.contact}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sm:hidden">
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <span class="hidden sm:inline">{t.nav.contact}</span>
      </a>
    </nav>
  </div>
</header>
