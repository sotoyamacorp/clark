---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleFilterTabs from '../components/ArticleFilterTabs.astro';
import { siteText } from '../lib/site-config';
import { sortedArticles as posts } from '../lib/articles';

const ctas = [
  {
    title: '最新の記事を読む',
    description:
      'クラーク進出を検討する日本企業に役立つ、歴史・制度・最新情報をまとめています。すべての情報に出典付き。',
    href: '/articles',
    label: '記事一覧を見る',
  },
  {
    title: '私たちについて',
    description:
      'なぜ私たちがこのデータベースを作っているのか。運営者の経歴と、フィリピン・クラークとの繋がりをご紹介します。',
    href: '/about',
    label: '私たちについて見る',
  },
  {
    title: '無料相談を申し込む',
    description:
      '進出の検討フェーズに合わせて、個別にご相談を承ります。まずはお気軽にお問い合わせください。',
    href: '/contact',
    label: '相談を申し込む',
  },
];
---

<BaseLayout title="ホーム">
  <section class="bg-navy-950">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
      <h1 class="mb-7 max-w-3xl text-4xl font-bold leading-tight tracking-tight text-accent-500 sm:text-5xl lg:max-w-none lg:whitespace-nowrap">
        フィリピン・クラークへの進出(個人/法人)を後押し
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-navy-200 lg:max-w-none lg:whitespace-nowrap">
        {siteText.ja.description}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20" aria-labelledby="articles-heading">
    <h2 id="articles-heading" class="mb-8 text-2xl font-bold text-navy-950">記事一覧</h2>

    <ArticleFilterTabs targetId="home-article-grid" locale="ja" />

    <div id="home-article-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <ArticleCard post={post} locale="ja" />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20" aria-label="3つの導線">
    <div class="grid gap-6 sm:grid-cols-3">
      {ctas.map((cta) => (
        <a
          href={cta.href}
          class="flex flex-col rounded-xl border border-navy-100 p-7 shadow-sm transition-shadow hover:shadow-md hover:border-navy-200"
        >
          <h2 class="mb-3 text-lg font-bold text-navy-950">{cta.title}</h2>
          <p class="mb-6 flex-1 text-base leading-relaxed text-navy-700">{cta.description}</p>
          <span class="font-semibold text-accent-700">{cta.label} →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
