---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site-config';

const ctas = [
  {
    title: '私たちについて',
    description:
      'なぜ私たちがこのデータベースを作っているのか。運営者の経歴と、フィリピン・クラークとの繋がりをご紹介します。',
    href: '/about',
    label: '私たちについて見る',
  },
  {
    title: '無料相談を申し込む',
    description:
      '進出の検討フェーズに合わせて、個別にご相談を承ります。まずはお気軽にお問い合わせください。',
    href: '/contact',
    label: '相談を申し込む',
  },
  {
    title: 'メールで直接質問する',
    description: '「まずは軽く聞きたい」という方は、メールで直接ご質問いただけます。',
    href: `mailto:${siteConfig.contactEmail}`,
    label: 'メールを送る',
  },
];

const principles = ['出典・収集時期を明記', '推計値には算出根拠を記載', '一般論だけの記事は掲載しない'];
---

<BaseLayout title="ホーム">
  <section class="bg-navy-950">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p class="eyebrow mb-4 text-sm font-semibold uppercase text-accent-500">
        {siteConfig.tagline}
      </p>
      <h1 class="mb-7 max-w-3xl text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">
        フィリピン・クラークの「知りたい」に、出典付きで応える。
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-navy-200">
        {siteConfig.description}
        すべての情報に出典と収集時期を明記して公開していきます。
      </p>

      <ul class="mt-10 flex flex-col gap-4 border-t border-navy-800 pt-8 sm:flex-row sm:gap-10">
        {principles.map((item) => (
          <li class="flex items-center gap-2 text-base text-navy-200">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20" aria-label="3つの導線">
    <div class="grid gap-6 sm:grid-cols-3">
      {ctas.map((cta) => (
        <a
          href={cta.href}
          class="flex flex-col rounded-xl border border-navy-100 p-7 shadow-sm transition-shadow hover:shadow-md hover:border-navy-200"
        >
          <h2 class="mb-3 text-lg font-bold text-navy-950">{cta.title}</h2>
          <p class="mb-6 flex-1 text-base leading-relaxed text-navy-700">{cta.description}</p>
          <span class="font-semibold text-accent-700">{cta.label} →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
