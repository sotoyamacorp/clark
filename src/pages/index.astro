---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site-config';

const ctas = [
  {
    title: '私たちについて',
    description:
      'なぜ私たちがこのデータベースを作っているのか。運営者の経歴と、フィリピン・クラークとの繋がりをご紹介します。',
    href: '/about',
    label: '私たちについて見る',
  },
  {
    title: '無料相談を申し込む',
    description:
      '進出の検討フェーズに合わせて、個別にご相談を承ります。まずはお気軽にお問い合わせください。',
    href: '/contact',
    label: '相談を申し込む',
  },
  {
    title: 'メールで直接質問する',
    description: '「まずは軽く聞きたい」という方は、メールで直接ご質問いただけます。',
    href: `mailto:${siteConfig.contactEmail}`,
    label: 'メールを送る',
  },
];
---

<BaseLayout title="ホーム">
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="mb-3 text-sm font-medium text-accent-600">{siteConfig.tagline}</p>
    <h1 class="mb-6 max-w-2xl text-3xl font-bold leading-relaxed text-navy-950 sm:text-4xl">
      フィリピン・クラーク進出の判断に必要な数字を、出典付きで。
    </h1>
    <p class="max-w-2xl text-lg leading-relaxed text-navy-800">
      {siteConfig.description}
      給与・賃料・制度・生活コストなどのデータは、すべて出典と収集時期を明記して公開していきます。
      一般論の記事ではなく、意思決定に使える一次情報を届けることを目的としています。
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6" aria-label="3つの導線">
    <div class="grid gap-6 sm:grid-cols-3">
      {ctas.map((cta) => (
        <a
          href={cta.href}
          class="flex flex-col rounded-lg border border-navy-100 p-6 transition-colors hover:border-accent-500"
        >
          <h2 class="mb-2 text-lg font-bold text-navy-900">{cta.title}</h2>
          <p class="mb-4 flex-1 text-base leading-relaxed text-navy-800">{cta.description}</p>
          <span class="font-medium text-accent-600">{cta.label} →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
