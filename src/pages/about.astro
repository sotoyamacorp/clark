---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import { founders } from '../lib/site-config';

const breadcrumbItems = [
  { name: 'ホーム', url: '/' },
  { name: '私たちについて', url: '/about' },
];

const visibleFounders = founders.filter((f) => f.published);
---

<BaseLayout
  title="私たちについて"
  description="なぜ私たちがフィリピン・クラーク通信を運営しているのか。運営者の経歴とフィリピン・クラークとの繋がりをご紹介します。"
>
  <Breadcrumb items={breadcrumbItems} locale="ja" />

  <section class="bg-navy-950">
    <div class="mx-auto max-w-[720px] px-4 py-14 sm:px-6">
      <p class="eyebrow mb-3 text-sm font-semibold uppercase text-accent-500">About us</p>
      <h1 class="mb-6 text-3xl font-bold tracking-tight text-white sm:text-4xl">私たちについて</h1>
      <p class="text-lg leading-relaxed text-navy-200">
        フィリピン・クラークへの進出を検討されている日本企業の皆様に向けて、必要な情報をわかりやすい形でお届けしながら、
        進出の後押しとサポートを行うことを目的に運営しています。
      </p>
    </div>
  </section>

  <article class="mx-auto max-w-[720px] px-4 py-14 sm:px-6">
    <section class="mb-16" aria-labelledby="clark-heading">
      <p class="eyebrow mb-2 text-sm font-semibold uppercase text-accent-700">About Clark</p>
      <h2 id="clark-heading" class="mb-4 text-2xl font-bold text-navy-950">
        クラークについて
      </h2>
      <p class="mb-6 text-lg leading-relaxed text-navy-700">
        なぜ私たちが「フィリピン全体」ではなく「クラーク」に特化して発信しているのか。まずはクラークというエリア自体について、押さえておきたいポイントをご紹介します。
      </p>

      <div class="mb-8 overflow-hidden rounded-xl border border-navy-100 shadow-sm">
        <iframe
          src="https://www.google.com/maps?saddr=Manila,+Philippines&daddr=Clark+Freeport+Zone,+Pampanga,+Philippines&output=embed"
          width="100%"
          height="380"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="マニラからクラークへのアクセスを示す地図"
        ></iframe>
      </div>

      <div class="space-y-5 text-lg leading-relaxed text-navy-700">
        <p>
          クラークは、東南アジアの新興都市として急速に発展してきたBGCになぞらえて「次のBGC」と呼ばれ始めているエリアです。
          クラーク国際空港を擁し、マニラ中心部からも車で約1時間半とアクセスが良好なため、日本からの出張・視察の動線にも組み込みやすい立地にあります。
          さらに今後は鉄道の開通や政府機関のオフィス移転も予定されており、インフラ・行政機能の両面でさらなる発展が見込まれています。
        </p>
        <p>
          クラークは元米軍基地という土地柄、街並みや道路が非常に整備されており、東南アジアの新興都市にありがちな煩雑さが少ないのも特徴です。
          すでに複数の日本企業が進出しているほか、物流の要となるスービック港にも近く、今後はAI・データセンターの一大拠点となる可能性でも世界から注目が集まりつつあります。
        </p>
        <p>
          ビジネス面だけでなく、暮らしの面での魅力も見逃せません。ゴルフ場が数多くあるほか、クラークが位置するパンパンガ州はシシグをはじめとする食文化でも知られています。
          ビジネスとしての将来性と、暮らしやすさの両方を体感できる。それが私たちがクラークに特化して発信を続けている理由です。
        </p>
      </div>
    </section>

    <section class="mb-16" aria-labelledby="founders-heading">
      <p class="eyebrow mb-2 text-sm font-semibold uppercase text-accent-700">Founders</p>
      <h2 id="founders-heading" class="mb-8 text-2xl font-bold text-navy-950">
        運営者について
      </h2>

      <div class={`grid gap-6 ${visibleFounders.length > 1 ? 'sm:grid-cols-2' : ''}`}>
        {visibleFounders.map((founder) => (
          <div class="rounded-xl border border-navy-100 p-7 shadow-sm">
            <div
              class="mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-navy-950 text-xl font-bold text-accent-500"
              aria-hidden="true"
            >
              {/* TODO: 顔写真に差し替える（例: <img src="/images/team/jio.jpg" alt={founder.name} class="h-20 w-20 rounded-full object-cover" />） */}
              {founder.name.charAt(0)}
            </div>
            <h3 class="mb-1 text-lg font-bold text-navy-950">{founder.name}</h3>
            <p class="mb-4 text-sm font-semibold text-accent-700">{founder.role.ja}</p>
            <div class="space-y-4 text-base leading-relaxed text-navy-700">
              {founder.bio.ja.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-16" aria-labelledby="connection-heading">
      <p class="eyebrow mb-2 text-sm font-semibold uppercase text-accent-700">Local Network</p>
      <h2 id="connection-heading" class="mb-4 text-2xl font-bold text-navy-950">
        現地との繋がり
      </h2>
      <p class="text-lg leading-relaxed text-navy-700">
        {/* TODO: プレースホルダー。現地の拠点・パートナー企業・ネットワークとの関係性を具体的に記載する */}
        ここに、フィリピン・クラーク現地でのネットワークや、現地パートナー企業との関係についての説明が入ります。
        データの収集方法や信頼性の裏付けにも繋がる、重要なセクションです。
      </p>
    </section>

    <section class="rounded-xl bg-navy-50 p-8" aria-labelledby="mission-heading">
      <p class="eyebrow mb-2 text-sm font-semibold uppercase text-accent-700">Our Principles</p>
      <h2 id="mission-heading" class="mb-4 text-2xl font-bold text-navy-950">
        このデータベースの方針
      </h2>
      <ul class="space-y-3 text-lg leading-relaxed text-navy-700">
        <li class="flex gap-3">
          <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-600" aria-hidden="true"></span>
          すべての数値には出典・収集時期・最終確認日を明記します
        </li>
        <li class="flex gap-3">
          <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-600" aria-hidden="true"></span>
          推計値には必ず算出根拠を記載します
        </li>
        <li class="flex gap-3">
          <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-600" aria-hidden="true"></span>
          一般論だけの記事は掲載しません
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>
