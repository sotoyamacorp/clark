---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import { siteConfig } from '../lib/site-config';

const breadcrumbItems = [
  { name: 'ホーム', url: '/' },
  { name: 'お問い合わせ', url: '/contact' },
];
---

<BaseLayout
  title="お問い合わせ"
  description="フィリピン・クラーク進出に関するご相談・お問い合わせはこちらから。"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="bg-navy-950">
    <div class="mx-auto max-w-[720px] px-4 py-14 sm:px-6">
      <p class="eyebrow mb-3 text-sm font-semibold uppercase text-accent-500">Contact</p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">お問い合わせ</h1>
      <p class="text-lg leading-relaxed text-navy-200">
        フィリピン・クラークへの進出をご検討の方は、下記フォームよりお気軽にご相談ください。
        情報収集の段階でも構いません。
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-[720px] px-4 py-14 sm:px-6">
    {siteConfig.tallyFormUrl ? (
      <iframe
        src={siteConfig.tallyFormUrl}
        width="100%"
        height="600"
        title="お問い合わせフォーム"
        class="rounded-xl border border-navy-100"
      />
    ) : (
      <div class="rounded-xl border border-navy-100 bg-navy-50 p-8 shadow-sm">
        <p class="mb-4 text-base leading-relaxed text-navy-700">
          {/* TODO: Tally でフォームを作成し、src/lib/site-config.ts の tallyFormUrl に埋め込みURLを設定する */}
          フォームの準備中です。お急ぎの場合は、メールにて直接ご連絡ください。
        </p>
        <a
          href={`mailto:${siteConfig.contactEmail}`}
          class="font-semibold text-accent-700 hover:underline"
        >
          {siteConfig.contactEmail} へメールを送る →
        </a>
      </div>
    )}
  </div>
</BaseLayout>
