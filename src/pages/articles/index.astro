---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleFilterTabs from '../../components/ArticleFilterTabs.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { sortedArticles as posts } from '../../lib/articles';
---

<BaseLayout title="記事一覧" description="クラーク進出に関する最新情報や分析を発信しています">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="mb-2 text-4xl font-bold text-navy-950">記事一覧</h1>
    <p class="mb-8 text-sm text-navy-600">新着順に表示しています</p>

    <ArticleFilterTabs targetId="articles-grid" locale="ja" />

    <div id="articles-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <ArticleCard post={post} locale="ja" />)}
    </div>

    <div class="mt-16">
      <NewsletterSignup locale="ja" />
    </div>
  </div>
</BaseLayout>
