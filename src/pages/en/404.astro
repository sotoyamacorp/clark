---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="mx-auto max-w-[720px] px-4 py-24 text-center sm:px-6">
    <h1 class="mb-4 text-3xl font-bold text-navy-950">Page Not Found</h1>
    <p class="mb-8 text-lg leading-relaxed text-navy-800">
      The page you're looking for may have been moved or removed.
    </p>
    <a href="/en/" class="font-semibold text-accent-700 hover:underline">Back to home →</a>
  </div>
</BaseLayout>
