---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import { siteConfig } from '../../lib/site-config';

const breadcrumbItems = [
  { name: 'Home', url: '/en/' },
  { name: 'Contact', url: '/en/contact' },
];

const segments = [
  {
    title: 'For Companies',
    eyebrow: 'For Companies',
    description:
      'For companies exploring expansion into Clark, Philippines. We can help from the early information-gathering stage, covering location, regulations, and hiring.',
    mailSubject: 'Inquiry about expanding into Clark',
  },
  {
    title: 'For Individuals',
    eyebrow: 'For Individuals',
    description:
      'For those interested in real estate or studying in Clark. We share first-hand information based on our family network on the ground.',
    mailSubject: 'Inquiry about real estate / studying in Clark',
  },
];

const faqs = [
  {
    q: 'Is the consultation free?',
    a: 'Yes, an initial consultation is free. Tell us where you currently stand and what you need.',
  },
  {
    q: 'How long does it take to get a reply?',
    a: 'We usually reply within 2-3 business days, though it may take longer depending on the request.',
  },
  {
    q: "Can I reach out even if I'm just starting to look into this?",
    a: "Of course. Feel free to contact us even at the information-gathering stage — we never push a hard sell.",
  },
];

const mailtoWithSubject = (subject: string) =>
  `mailto:${siteConfig.contactEmail}?subject=${encodeURIComponent(subject)}`;
---

<BaseLayout
  title="Contact"
  description="Get in touch for questions or consultations about expanding into Clark, Philippines."
>
  <Breadcrumb items={breadcrumbItems} locale="en" />

  <section class="bg-navy-950">
    <div class="mx-auto max-w-[720px] px-4 py-14 sm:px-6">
      <p class="eyebrow mb-3 text-sm font-semibold uppercase text-accent-500">Contact</p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Contact</h1>
      <p class="text-lg leading-relaxed text-navy-200">
        If you're considering expanding into Clark, Philippines, feel free to reach out.
        It's fine even if you're just gathering information at this stage.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-[720px] px-4 py-14 sm:px-6">
    <div class="mb-12 grid gap-6 sm:grid-cols-2">
      {segments.map((segment) => (
        <div class="flex flex-col rounded-xl border border-navy-100 p-7 shadow-sm">
          <p class="eyebrow mb-2 text-xs font-semibold uppercase text-accent-700">{segment.eyebrow}</p>
          <h2 class="mb-3 text-lg font-bold text-navy-950">{segment.title}</h2>
          <p class="mb-6 flex-1 text-base leading-relaxed text-navy-700">{segment.description}</p>
          <a
            href={mailtoWithSubject(segment.mailSubject)}
            class="font-semibold text-accent-700 hover:underline"
          >
            Email us →
          </a>
        </div>
      ))}
    </div>

    {siteConfig.tallyFormUrl ? (
      <iframe
        src={siteConfig.tallyFormUrl}
        width="100%"
        height="600"
        title="Contact form"
        class="rounded-xl border border-navy-100"
      />
    ) : (
      <div class="rounded-xl border border-navy-100 bg-navy-50 p-8 shadow-sm">
        <p class="mb-2 text-lg font-bold text-navy-950">Reach us by email for now</p>
        <p class="mb-6 text-base leading-relaxed text-navy-700">
          Our contact form is still being set up. If you're in a hurry, please email us directly
          below — we usually reply within 2-3 business days.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={mailtoWithSubject('Inquiry')}
            class="rounded-full bg-navy-950 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-navy-800"
          >
            Email {siteConfig.contactEmail}
          </a>
          <a
            href={siteConfig.twitterUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-accent-700 hover:underline"
          >
            See our X account →
          </a>
        </div>
      </div>
    )}

    <section class="mt-16" aria-labelledby="faq-heading">
      <p class="eyebrow mb-2 text-sm font-semibold uppercase text-accent-700">FAQ</p>
      <h2 id="faq-heading" class="mb-6 text-2xl font-bold text-navy-950">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-lg border border-navy-100 p-5">
            <summary class="cursor-pointer list-none font-semibold text-navy-950 marker:content-none">
              <span class="flex items-center justify-between gap-4">
                {faq.q}
                <span class="shrink-0 text-accent-700 transition-transform group-open:rotate-45">＋</span>
              </span>
            </summary>
            <p class="mt-3 text-base leading-relaxed text-navy-700">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
