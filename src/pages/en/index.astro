---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleFilterTabs from '../../components/ArticleFilterTabs.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { sortedArticles as posts } from '../../lib/articles';

const ctas = [
  {
    title: 'Read the latest articles',
    description:
      'History, policy, and up-to-date information for Japanese companies exploring Clark. Every article is backed by sources.',
    href: '/en/articles',
    label: 'View all articles',
  },
  {
    title: 'About Us & Clark',
    description:
      "Why we're building this resource, our founder's background, and our connection to the Philippines and Clark.",
    href: '/en/about',
    label: 'Learn more',
  },
  {
    title: 'Get a free consultation',
    description:
      'Whatever stage of consideration you’re at, feel free to reach out for an individual consultation.',
    href: '/en/contact',
    label: 'Get in touch',
  },
];
---

<BaseLayout title="Home">
  <section class="bg-navy-950">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
      <h1 class="mb-7 max-w-3xl text-4xl font-bold leading-tight tracking-tight text-accent-500 sm:text-5xl lg:max-w-none lg:whitespace-nowrap">
        Supporting expansion into Clark, Philippines
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-navy-200">
        We run this site for Japanese companies considering expansion into Clark, Philippines —
        bringing together the information you need in a clear, accessible form to push and
        support that move forward.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20" aria-labelledby="articles-heading">
    <h2 id="articles-heading" class="mb-2 text-2xl font-bold text-navy-950">Articles</h2>
    <p class="mb-8 text-sm text-navy-600">Sorted by newest first</p>

    <ArticleFilterTabs targetId="home-article-grid" locale="en" />

    <div id="home-article-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <ArticleCard post={post} locale="en" />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <NewsletterSignup locale="en" />
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20" aria-label="Three ways to explore">
    <div class="grid gap-6 sm:grid-cols-3">
      {ctas.map((cta) => (
        <a
          href={cta.href}
          class="flex flex-col rounded-xl border border-navy-100 p-7 shadow-sm transition-shadow hover:shadow-md hover:border-navy-200"
        >
          <h2 class="mb-3 text-lg font-bold text-navy-950">{cta.title}</h2>
          <p class="mb-6 flex-1 text-base leading-relaxed text-navy-700">{cta.description}</p>
          <span class="font-semibold text-accent-700">{cta.label} →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
